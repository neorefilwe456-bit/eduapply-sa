# Copy this file to .env.local and fill in your own Supabase project values.
# Find these under: Supabase Dashboard > Project Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Only needed later for server-side admin actions (Phase 2+).
# NEVER expose this in client-side code or commit it to git.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
